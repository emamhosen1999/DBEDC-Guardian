{
  "v": 3,
  "name": "DBEDC Guardian — Full API Collection",
  "folders": [
    {
      "v": 3,
      "name": "🔐 Authentication",
      "folders": [],
      "requests": [
        {
          "v": "5",
          "name": "Mobile Login (Sanctum Token)",
          "method": "POST",
          "endpoint": "<<base_url>>/api/v1/auth/login",
          "headers": [
            { "key": "Content-Type", "value": "application/json", "active": true },
            { "key": "Accept", "value": "application/json", "active": true }
          ],
          "body": {
            "contentType": "application/json",
            "body": "{\n  \"email\": \"<<test_email>>\",\n  \"password\": \"<<test_password>>\",\n  \"device_name\": \"hoppscotch-test\"\n}"
          }
        },
        {
          "v": "5",
          "name": "Refresh Token",
          "method": "POST",
          "endpoint": "<<base_url>>/api/v1/auth/refresh",
          "headers": [
            { "key": "Content-Type", "value": "application/json", "active": true },
            { "key": "Authorization", "value": "Bearer <<token>>", "active": true }
          ],
          "body": {
            "contentType": "application/json",
            "body": "{\n  \"refresh_token\": \"<<refresh_token>>\"\n}"
          }
        },
        {
          "v": "5",
          "name": "Get Current User",
          "method": "GET",
          "endpoint": "<<base_url>>/api/v1/auth/me",
          "headers": [
            { "key": "Authorization", "value": "Bearer <<token>>", "active": true },
            { "key": "Accept", "value": "application/json", "active": true }
          ]
        },
        {
          "v": "5",
          "name": "Logout",
          "method": "POST",
          "endpoint": "<<base_url>>/api/v1/auth/logout",
          "headers": [
            { "key": "Authorization", "value": "Bearer <<token>>", "active": true }
          ]
        }
      ]
    },
    {
      "v": 3,
      "name": "📡 Biometric Webhooks",
      "folders": [],
      "requests": [
        {
          "v": "5",
          "name": "Attendance Webhook (ZKTeco Push)",
          "method": "POST",
          "endpoint": "<<base_url>>/api/biometric/webhook",
          "headers": [
            { "key": "Content-Type", "value": "application/json", "active": true }
          ],
          "body": {
            "contentType": "application/json",
            "body": "{\n  \"device_token\": \"<<device_token>>\",\n  \"event\": \"attendance\",\n  \"data\": {\n    \"user_id\": 1,\n    \"timestamp\": \"2026-10-04T13:00:00+06:00\",\n    \"verify_type\": 1,\n    \"in_out_status\": 0\n  }\n}"
          }
        },
        {
          "v": "5",
          "name": "Device Heartbeat",
          "method": "POST",
          "endpoint": "<<base_url>>/api/biometric/heartbeat",
          "headers": [
            { "key": "Content-Type", "value": "application/json", "active": true }
