          "method": "GET",
          "endpoint": "<<base_url>>/api/v1/attendance/monthly-summary?month=2026-10",
          "headers": [
            { "key": "Authorization", "value": "Bearer <<token>>", "active": true }
          ]
        },
        {
          "v": "5",
          "name": "Team Day Partition",
