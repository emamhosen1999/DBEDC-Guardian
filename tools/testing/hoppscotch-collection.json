          "body": {
            "contentType": "application/json",
            "body": "{\n  \"device_token\": \"<<device_token>>\",\n  \"device_id\": \"MB460-01\",\n  \"firmware\": \"Ver 6.60\",\n  \"ip\": \"192.168.1.100\"\n}"
          }
        }
      ]
    },
    {
      "v": 3,
      "name": "🕐 Attendance (Mobile)",
      "folders": [],
